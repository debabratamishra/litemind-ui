---
import Base from '../layouts/Base.astro';
import { u } from '../lib/urls';
import { features, benefits, steps, enterpriseTiles } from '../data/home';
import CardGrid from '../components/CardGrid.astro';
import Steps from '../components/Steps.astro';
import Callout from '../components/Callout.astro';
import SectionHead from '../components/SectionHead.astro';
---
<Base title="LiteMindUI: your private AI workspace" description="LiteMindUI is a friendly, private AI workspace you run on your own computer: chat, ask questions about your files, search the web, and talk out loud.">
  <!-- Hero section -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Private · Local-first · Open source</p>
      <h1>Your own AI workspace<br>private, friendly, and easy</h1>
      <p class="lead">
        LiteMindUI lets you chat, ask questions about <em>your own files</em>,
        search the web, and even talk out loud with an AI that runs on your
        computer. Your data stays with you.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="https://github.com/debabratamishra/litemind-ui" target="_blank" rel="noopener">Get LiteMindUI</a>
        <a class="btn btn-ghost" href={`${u('/developer/')}`}>For Developers&nbsp;→</a>
      </div>
    </div>
  </section>

  <!-- What is LiteMindUI? -->
  <section class="block">
    <div class="container">
      <SectionHead title="What is LiteMindUI?" />
      <p>
        Think of it as a friendly helper that lives on your computer. You type
        or speak to it, and it answers, writes, and finds things for you, using
        either a smart AI model on your machine or one from the internet, your
        choice.
      </p>

      <div class="cards">
        {features.map((card) => (
          // @ts-ignore
          <div class="card" key={card.title}>
            <div class="icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>

      <figure class="demo">
        <img src={`${u('/assets/demo.gif')}`} alt="Short demo of LiteMindUI in action" />
        <figcaption>A quick look at LiteMindUI: chatting, asking documents, and more.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Why people choose LiteMindUI -->
  <section class="block soft">
    <div class="container">
      <SectionHead title="Why people choose LiteMindUI" lead="It is built to be calm, capable, and respectful of your privacy." />
      <div class="cards">
        {benefits.map((card) => (
          // @ts-ignore
          <div class="card" key={card.title}>
            <div class="icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How do I get started? -->
  <section class="block">
    <div class="container">
      <SectionHead title="How do I get started?" lead="Three simple steps. The details live in the project README, and here is the friendly version." />
      <div class="steps">
        {steps.map((step, idx) => (
          // @ts-ignore
          <div class="step" key={idx}>
            <div class="num"></div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>

      <div class="callout" style="margin-top:32px;">
        <strong>Good to know:</strong> You can start with a small AI model that runs privately on your computer, or connect a more powerful cloud model later. Either way, you stay in control of your data.
      </div>

      <div style="text-align:center;margin-top:28px;">
        <a class="btn btn-outline" href="https://github.com/debabratamishra/litemind-ui" target="_blank" rel="noopener">Read the setup guide on GitHub</a>
      </div>
    </div>
  </section>

  <!-- Curious about how it works? -->
  <section class="block soft">
    <div class="container prose" style="margin:0 auto;text-align:center;">
      <h2>Curious about how it works?</h2>
      <p style="max-width:640px;margin:0 auto;">
        If you like computers and want to see the engines under the hood,
        including the architecture, the APIs, and the design, we wrote a <a href={`${u('/developer/')}`}>Developer guide</a> just for you.
      </p>
    </div>
  </section>

  <!-- Enterprise section -->
  <section class="block enterprise">
    <div class="container prose" style="margin:0 auto;text-align:center;">
      <h2>Building something bigger?</h2>
      <p style="max-width:680px;margin:0 auto;">
        LiteMindUI is free and open source, and a great fit for personal use and small
        teams. If you are rolling it out across a company, or need it to meet stricter
        requirements, I offer <strong>enterprise support</strong> shaped around how your
        organisation actually works.
      </p>

      <div class="cards" style="margin-top:30px;text-align:left;">
        {enterpriseTiles.map((tile) => (
          // @ts-ignore
          <div class="card" key={tile.title}>
            <div class="icon">{tile.icon}</div>
            <h3>{tile.title}</h3>
            <p>{tile.body}</p>
          </div>
        ))}
      </div>

      <div class="ent-cta">
        <p>
          Have a use case in mind, or want to see what is possible for your team? Reach
          out and we can talk through how LiteMindUI can support your business.
        </p>
        <a class="btn btn-solid" href="mailto:debabrata.mishra641@gmail.com?subject=LiteMindUI%20enterprise%20support">Email me about enterprise support</a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Parallax and float animation control with prefers-reduced-motion
    const hero = document.querySelector('.hero');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let animationFrameId = null;
    let lastX = 0, lastY = 0;

    function updateParallax(e) {
      if (reduceMotion.matches) {
        // If reduced motion, reset to center and cancel animation
        lastX = 0;
        lastY = 0;
        hero.style.setProperty('--hero-bg-x', '0%');
        hero.style.setProperty('--hero-bg-y', '0%');
        return;
      }
      // Convert mouse position to -100 to 100 range for subtle effect
      const x = (e.clientX - window.innerWidth / 2) / (window.innerWidth / 2) * 10; // 10% range
      const y = (e.clientY - window.innerHeight / 2) / (window.innerHeight / 2) * 10;
      // Smooth easing
      lastX += (x - lastX) * 0.1;
      lastY += (y - lastY) * 0.1;
      hero.style.setProperty('--hero-bg-x', `${50 + lastX}%`);
      hero.style.setProperty('--hero-bg-y', `${50 + lastY}%`);
    }

    function startParallax() {
      if (reduceMotion.matches) return;
      window.addEventListener('mousemove', updateParallax);
      // Also trigger initial update to set correct position
      updateParallax({ clientX: window.innerWidth / 2, clientY: window.innerHeight / 2 });
    }

    function stopParallax() {
      window.removeEventListener('mousemove', updateParallax);
      cancelAnimationFrame(animationFrameId);
    }

    // Initialize
    if (!reduceMotion.matches) {
      startParallax();
    }

    // Cleanup on page hide/unload
    window.addEventListener('visibilitychange', () => {
      if (document.hidden) stopParallax();
      else startParallax();
    });
  </script>
</Base>