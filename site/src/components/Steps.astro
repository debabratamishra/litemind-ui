---
import type { StepData } from '../data/home';
interface Props {
  steps: StepData[];
}
const { steps } = Astro.props;
---
<div class="steps">
  {steps.map((step, idx) => (
    // @ts-ignore
    <div class="step" key={idx}>
      {/* @ts-ignore */}
      <div class="num"></div>
      <h3>{step.title}</h3>
      <p>{step.body}</p>
    </div>
  ))}
</div>