---
import type { IconName } from '../data/home';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'chat' && (
    <path d="M20 11.5c0 4.1-3.6 7.5-8 7.5-1 0-2-.16-2.87-.46L4 20l1.08-3.2C3.77 15.4 3 13.55 3 11.5 3 7.4 6.6 4 11 4s9 3.4 9 7.5Z" />
  )}
  {name === 'document' && (
    <>
      <path d="M7 3.5h6.5L18 8v12.5H7z" />
      <path d="M13 3.5V8h4.5M9.5 12h5M9.5 15.5h5" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M3.5 12h17M12 3.5c2.2 2.3 3.3 5.2 3.3 8.5S14.2 18.2 12 20.5c-2.2-2.3-3.3-5.2-3.3-8.5S9.8 5.8 12 3.5Z" />
    </>
  )}
  {name === 'voice' && (
    <>
      <rect x="9" y="3" width="6" height="11" rx="3" />
      <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7" />
    </>
  )}
  {name === 'local' && (
    <>
      <rect x="3.5" y="5" width="17" height="11" rx="2" />
      <path d="M7 19.5h10M12 16v3.5M7.5 9h4M7.5 12.5h6" />
    </>
  )}
  {name === 'ownership' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <circle cx="12" cy="10" r="2.2" />
      <path d="M12 12.2v4.3M9.5 14h5" />
    </>
  )}
  {name === 'browser' && (
    <>
      <rect x="3.5" y="5" width="17" height="14" rx="2" />
      <path d="M3.5 9h17M6.5 7h.01M9.5 7h.01" />
    </>
  )}
  {name === 'open' && (
    <path d="M8.5 5.5c-2 0-3 1.2-3 3v3c0 1-.4 1.8-1.5 2.5 1.1.7 1.5 1.5 1.5 2.5v3c0 1.8 1 3 3 3M15.5 5.5c2 0 3 1.2 3 3v3c0 1 .4 1.8 1.5 2.5-1.1.7-1.5 1.5-1.5 2.5v3c0 1.8-1 3-3 3" />
  )}
  {name === 'server' && (
    <>
      <rect x="4" y="4" width="16" height="6.5" rx="1.5" />
      <rect x="4" y="13.5" width="16" height="6.5" rx="1.5" />
      <path d="M7.5 7.25h.01M7.5 16.75h.01" />
    </>
  )}
  {name === 'access' && (
    <>
      <circle cx="9" cy="9" r="4.5" />
      <path d="m12.2 12.2 7.3 7.3M16.5 16.5l2-2M19 19l2-2" />
    </>
  )}
  {name === 'integration' && (
    <>
      <circle cx="5.5" cy="12" r="2.2" />
      <circle cx="18.5" cy="5.5" r="2.2" />
      <circle cx="18.5" cy="18.5" r="2.2" />
      <path d="m7.6 11 8.7-4.5M7.6 13l8.7 4.5" />
    </>
  )}
</svg>
