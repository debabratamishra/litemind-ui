---
import { u } from '../lib/urls';
const year = new Date().getFullYear();
const repoUrl = 'https://github.com/debabratamishra/litemind-ui';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href={u('/')} aria-label="LiteMindUI home">
        <span class="logo" aria-hidden="true"><span>L</span></span>
        <span>LiteMindUI</span>
      </a>
      <p>A local-first AI workspace you can run, inspect, and adapt. Chat, retrieve from documents, search the web, and use voice from one interface.</p>
    </div>
    <div class="footer-links">
      <div>
        <h2>Product</h2>
        <a href={u('/')}>Overview</a>
        <a href={`${u('/#workspace')}`}>Workspace</a>
        <a href={`${u('/#faq')}`}>Deployment questions</a>
      </div>
      <div>
        <h2>Build</h2>
        <a href={u('/developer/')}>Developer guide</a>
        <a href={`${repoUrl}/blob/main/docs/api-contract.md`} target="_blank" rel="noopener">API contract</a>
        <a href={`${repoUrl}/releases`} target="_blank" rel="noopener">Releases</a>
      </div>
      <div>
        <h2>Project</h2>
        <a href={repoUrl} target="_blank" rel="noopener">Source code</a>
        <a href={`${repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener">License</a>
        <a href="mailto:debabrata.mishra641@gmail.com?subject=LiteMindUI%20enterprise%20support">Enterprise support</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} LiteMindUI</span>
    <span>Free and open source · Built with Astro</span>
  </div>
</footer>
